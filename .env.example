# Tombstone SG — environment template. COPY to .env and fill. NEVER commit .env.
# All keys below are TESTNET ONLY. Use throwaway wallets.

# CRE (Chainlink Runtime Environment)
CRE_ETH_PRIVATE_KEY=          # 64 hex, no 0x, testnet only — signs --broadcast txs
CRE_TARGET=staging-settings
# CRE_API_KEY=

# NOWNodes — free key works ONLY on eth.nownodes.io and eth-sepolia.nownodes.io
NOWNODES_API_KEY=none
CRE_NOWNODES_API_KEY=none
NOWNODES_CHAINS=ethereum,sepolia

# Deploy / demo wallets (testnet only)
PRIVATE_KEY=
TAN_PRIVATE_KEY=
DEPLOYER_ADDRESS=
TAN_ADDRESS=
TAN_NEW_ADDRESS=
BOB_ADDRESS=
CAROL_ADDRESS=

# RPC endpoints (public, no key needed)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# ETHERSCAN_API_KEY=
